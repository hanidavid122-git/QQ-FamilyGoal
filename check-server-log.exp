#!/usr/bin/expect -f

set timeout 30
set ip "192.129.226.17"
set pass "4Qax1f6SIW9dIy2g4Y"

send_user "\n正在连接服务器查看 PM2 日志以实证数据库连接状态...\n"

spawn ssh -o StrictHostKeyChecking=no root@$ip
expect {
    "password:" {
        send "$pass\r"
        exp_continue
    }
    "*# " {
        # 1. 打印 pm2 status 看重启状态
        # 2. 打印最新 40 行运行日志，包括数据库请求记录
        send "echo '--- PM2 STATUS ---' && pm2 status family-goal && echo '--- RECENT LOGS ---' && pm2 log family-goal --lines 40 --no-daemon\r"
        expect "*# "
        send "exit\r"
    }
}
expect eof
